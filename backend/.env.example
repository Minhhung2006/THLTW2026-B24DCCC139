# ──────────────────────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# DATABASE — SQL Server (Prisma)
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;trustServerCertificate=true
# ──────────────────────────────────────────────────────────────
DATABASE_URL="sqlserver://localhost:1433;database=esports_tournament;user=sa;password=YourPassword@123;trustServerCertificate=true"

# ──────────────────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# EMAIL (Nodemailer — Gmail SMTP)
# ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Esports Tournament <noreply@esports.com>"
