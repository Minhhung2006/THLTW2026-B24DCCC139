generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ──────────────────────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tournaments   Tournament[]   @relation("UserTournaments")
  registrations Registration[]
  notifications Notification[]

  @@map("users")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  game        String
  description String?          @db.Text
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  maxTeams    Int              @map("max_teams")
  status      TournamentStatus @default(UPCOMING)
  banner      String?
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  createdBy     User           @relation("UserTournaments", fields: [createdById], references: [id])
  registrations Registration[]

  @@index([createdById])
  @@index([status])
  @@map("tournaments")
}

model Registration {
  id           String             @id @default(cuid())
  tournamentId String             @map("tournament_id")
  userId       String             @map("user_id") // Người nộp đơn
  teamName     String             @map("team_name")
  status       RegistrationStatus @default(PENDING)
  note         String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Relations
  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  members    RegMember[]

  @@unique([tournamentId, userId]) // Một user chỉ được nộp 1 đơn cho 1 giải
  @@index([tournamentId])
  @@index([userId])
  @@map("registrations")
}

model RegMember {
  id             String       @id @default(cuid())
  registrationId String       @map("registration_id")
  memberName     String       @map("member_name")
  gameId         String       @map("game_id")

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("reg_members")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  type      String?  // e.g., "REGISTRATION_UPDATE", "SYSTEM"
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}
